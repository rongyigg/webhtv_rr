    <!-- 详情页焦点态用色（原版 red / red_500）：补上逆向资源缺失的引用。 -->
    <color name="red">#E50914</color>
    <color name="red_500">#F44336</color>
    <!--
        HeroUI 全局高亮色：与 HeroHomeActivity 的 `HeroAccentColor = Color(0xFFFF0000)`
        以及 HeroPosterCard 的 `FOCUS_COLOR = 0xFFFF0000` 是同一个红。
        View 侧需要颜色资源（selector / shape 用），所以在这里落一份唯一来源；
        Hero 页面若再加新的焦点控件，一律引用本资源，不得新造第二种高亮色。
    -->
    <color name="hero_accent">#FFFF0000</color>

    <!--
        首页分类 Tab 三态取色（唯一真值；代码里禁止再写十六进制）：
        - 焦点实心 = 横向线性渐变 #E50914 → #FF7A85，2 段，不是 3 段。
          来源：ref_docs/tab_ui.png 焦点胶囊沿 x 扫描（胶囊 x=29..135、y=33）：
          x=41 #E81621 → x=119 #F96870，两端各外推 12px 正好落在 #E50914 / #FF7A85；
          中段实测 #F1424B 与 2 段中点 #F2424C 吻合，说明中心色不是 #F44336。
        - 选中描边 = #E50914，即 @color/red（ref_docs/shape_red_bar.xml / shape_tmdb_badge.xml 原值），
          宽度 2dp 照抄工程内同族 shape_source_site_chip_selected.xml。
        - 未选中胶囊底 = @color/black_20（#33000000）：ref_docs/tab_ui.png 胶囊内/外明暗比
          实测 0.79~0.80 → 20% 黑。
        - 未选中文字 = #99FFFFFF（ref_docs/dialog_source.xml 原值，等于 Compose `White.copy(alpha=0.6f)`）。
    -->
    <color name="home_tab_focus_start">@color/red</color>
    <color name="home_tab_focus_end">#FF7A85</color>
    <color name="home_tab_stroke">@color/red</color>
    <color name="home_tab_idle_surface">@color/black_20</color>
    <color name="home_tab_idle_text">#99FFFFFF</color>

    <!--
        播放页 OSD 全局焦点色（唯一真值，等价于需求里的 `OsdFocusColor`）：
        取 ref_docs/player_down_controls.png / ref_docs/player_menu_overlay.png 里
        被选中按钮的红色高亮，是 #E53935 → #C62828 的纵向渐变，不是纯红 #FF0000。
        后期换色只改这里，禁止在 layout / drawable 里另写红色十六进制。
    -->
    <!-- 全局「细线红框」统一色（需求指定 @color/osd_red_end）：首页 Tab / 设置项 / 列表焦点 / 选集卡片共用。 -->
    <color name="osd_red_end">#FFE53935</color>
    <color name="osd_focus">@color/osd_red_end</color>
    <color name="osd_focus_dark">#FFC62828</color>
    <!-- 选集卡片默认态：深色半透明（需求指定 #33FFFFFF）。 -->
    <color name="osd_surface">#33FFFFFF</color>
    <!--
        选集卡片 / OSD 焦点胶囊（取自原逆向 App 的界面截图取样，不是估算）：
        未选中卡片黑底 #1A1A1A；选中/焦点为左深右浅的水平红渐变 #E50914 → #FD7D83。
    -->
    <color name="osd_card">#FF1A1A1A</color>
    <color name="osd_accent">#FFE50914</color>
    <color name="osd_accent_light">#FFFD7D83</color>
    <!-- OSD 底部遮罩：透明 → #CC000000 的两段渐变。 -->
    <color name="osd_scrim_start">#00000000</color>
    <color name="osd_scrim_end">#CC000000</color>
    <!-- 选集面板底部背景（ref_docs/bg_episode_list_bottom）：透明 → #F2000000。 -->
    <color name="osd_panel_end">#F2000000</color>
    <!-- 全局底部面板遮罩（选集 / 轨道面板共用）：顶部透明 → 底部 #E6000000，透出视频画面。 -->
    <color name="panel_scrim_end">#E6000000</color>
    <!-- 底部面板（选集 / 轨道）的半透明深灰底：视频纯黑时面板也要能看出边界，同时不完全遮挡画面。 -->
    <color name="panel_scrim_base">#CC222222</color>
    <!-- 手动 TMDB 匹配弹窗底色：去掉全屏遮罩后，靠这层 95% 深灰把弹窗自己“垫”起来 -->
    <color name="panel_dialog_solid">#F2222222</color>
</resources>
