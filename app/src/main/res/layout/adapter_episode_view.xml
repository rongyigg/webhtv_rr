<?xml version="1.0" encoding="utf-8"?>
<!--
    选集格子：结构逐字照抄 ref_docs/adapter_episode.xml。

    - 根 FrameLayout 就是可聚焦本体，高 38dp、4dp 圆角（本轮红线固定高度）。
      背景就是这张卡的背景，卡片多高底板就多高，上下不多一个像素。
      网格 176dp = 4 × 38 + 3 × 8。
    - 文字 14sp、单行 marquee 跑马灯（焦点滚动，失焦按 end 截断）。
      TextView 用 match_parent + gravity=center + includeFontPadding=false 做**真正的**
      垂直居中：不靠 wrap_content 的字形上下留白，也不加任何 paddingTop/Bottom。
      跑马灯只在**焦点卡片**上滚动（EpisodeAdapter.applyMarquee），失焦时按 end 截断。
    - 文字颜色由 EpisodeAdapter 按「焦点 / 动作指令 / 真实播放 / 常态」四态设置，
      焦点红底卡片一律纯白字（cell 的焦点态不会下发给子 TextView，必须代码显式重刷）。
    - 右侧 LottieAnimationView（20×25dp）**垂直居中**，与 OSD 同位置：38dp 卡内 25dp
      图标上下各留 6.5dp，不用负边距，绝不越出卡片背景。
    - clipChildren / clipToPadding = true（与 OSD 一致）：卡片内不放任何越界元素。

    三态背景见 @drawable/selector_episode_cell_background。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cell"
    android:layout_width="match_parent"
    android:layout_height="38dp"
    android:background="@drawable/selector_episode_cell_background"
    android:clipChildren="true"
    android:clipToPadding="true"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <TextView
        android:id="@+id/text"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:ellipsize="marquee"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:includeFontPadding="false"
        android:marqueeRepeatLimit="marquee_forever"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:singleLine="true"
        android:textColor="@color/white"
        android:textSize="14sp" />

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottie"
        android:layout_width="20dp"
        android:layout_height="25dp"
        android:layout_gravity="end|center_vertical"
        android:visibility="gone"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/equalizer" />
</FrameLayout>
