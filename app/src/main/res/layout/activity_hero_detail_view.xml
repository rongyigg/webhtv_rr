<?xml version="1.0" encoding="utf-8"?>
<!--
    Hero 详情页（纯 View 体系）静态骨架，阶段 A 第一步。

    本轮只画排版，不接数据、不写 Activity 业务逻辑：
    - 文案：DEMO_DETAIL（后会无期 / 2026 · 剧情 · 全 50 集 · 9.1 / 10 位演员）
    - 背景、海报、头像：本地渐变 drawable，不联网
    - 按钮和演员项可聚焦，焦点态用 selector / stateListAnimator 静态演示
    - 真实数据、焦点流转、点击事件、弹窗都在 Plan A 后续步骤接

    尺寸基准：1920×1080 / density 2（960×540dp），Compose 规格逐项照抄。
    结构：
    FrameLayout
    ├─ backdrop
    ├─ maskHorizontal
    ├─ maskVertical
    ├─ posterCard 150×210dp，top 72dp / end 80dp
    └─ detailContent（贴底，左右 24dp、底部 32dp）
       ├─ titleSlot（无 Logo 36dp；有 Logo 时换成 96dp 的 titleLogoSlot）
       ├─ 2dp
       ├─ metaSlot 20dp
       ├─ 4dp
       ├─ synopsis（最宽 440dp、最多 4 行）
       ├─ credit（上间距 8dp）
       ├─ loadingRow / stateText（默认 GONE，留给后续状态切换）
       ├─ 12dp
       ├─ actionRow 36dp（播放 / 换源 / 收藏）
       └─ 16dp
          castSection（红条标题 + 10 个 76dp 演员项）
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/heroDetailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:context=".ui.activity.HeroDetailViewPreviewActivity">

    <!-- ① 全屏背景大图：真实页面由 Coil 加载，这里用本地渐变占位。 -->
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_hero_detail_demo_backdrop" />

    <!-- ② 横向遮罩：左侧 35% 内压黑托住标题和简介，右侧保持透亮。 -->
    <View
        android:id="@+id/maskHorizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_hero_detail_mask_h" />

    <!-- ③ 纵向遮罩：上 55% 保持原亮度，底部渐到 90% 黑。 -->
    <View
        android:id="@+id/maskVertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_hero_detail_mask_v" />

    <!--
        ④ 右上角浮动小海报：150×210dp，top 72dp / end 80dp，内边距 4dp，圆角 12dp。
        真实规则：有 TMDB 背景大图时整块 GONE；这里先显示，方便核对尺寸和位置。
    -->
    <FrameLayout
        android:id="@+id/posterCard"
        android:layout_width="150dp"
        android:layout_height="210dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="72dp"
        android:layout_marginEnd="80dp"
        android:background="@drawable/shape_poster_card"
        android:clipToOutline="true"
        android:padding="4dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/poster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_hero_detail_demo_poster" />

    </FrameLayout>

    <!-- ⑤ 左下内容区：整体贴底，左右 24dp、底部 32dp。 -->
    <LinearLayout
        android:id="@+id/detailContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <!--
            5.1 剧名区。
            无 Logo：36dp 行高 + 32sp 粗体白字 + 跑马灯，文字贴底左对齐。
            有 Logo：把 titleTextSlot 设为 GONE、titleLogoSlot 设为 VISIBLE，整行自动变成 96dp。
            两种情况都不挂 focusable，遥控器选不中。
        -->
        <FrameLayout
            android:id="@+id/titleSlot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!--
                无 Logo 的文本槽：固定 36dp，文字自身 40dp 高、贴底对齐；
                32sp 的固有行高略高于 36dp，靠外层 clipChildren=false 向上溢出，
                和 Compose「36dp 盒子里 BottomStart 放 32sp 文字」一致。
            -->
            <FrameLayout
                android:id="@+id/titleTextSlot"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/titleText"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_gravity="bottom|start"
                    android:ellipsize="marquee"
                    android:focusable="false"
                    android:gravity="bottom|start"
                    android:includeFontPadding="false"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:shadowColor="#CC000000"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="12"
                    android:singleLine="true"
                    android:text="后会无期"
                    android:textColor="@color/white"
                    android:textSize="32sp"
                    android:textStyle="bold" />

            </FrameLayout>

            <!--
                Logo 槽：默认 GONE。真实页面用 Coil 加载 TMDB 艺术字；
                槽本身固定 96dp 高、最宽 720dp，图片等比缩放并贴底左对齐。
                切到 Logo 分支时：titleTextSlot 设 GONE，本槽设 VISIBLE。
            -->
            <FrameLayout
                android:id="@+id/titleLogoSlot"
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:visibility="gone">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/titleLogo"
                    android:layout_width="wrap_content"
                    android:layout_height="96dp"
                    android:layout_gravity="bottom|start"
                    android:adjustViewBounds="true"
                    android:contentDescription="@null"
                    android:maxHeight="96dp"
                    android:maxWidth="720dp"
                    android:scaleType="fitStart"
                    android:src="@drawable/bg_hero_detail_demo_logo" />

            </FrameLayout>

        </FrameLayout>

        <!-- 标题 → 元数据：2dp。 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp" />

        <!--
            5.2 元数据：固定 20dp 高、14sp、#CCFFFFFF、文字贴底。
            真实文案由详情接口 / TMDB 合并后填入。
        -->
        <FrameLayout
            android:id="@+id/metaSlot"
            android:layout_width="match_parent"
            android:layout_height="20dp">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:shadowColor="#AA000000"
                android:shadowDx="1.5"
                android:shadowDy="1.5"
                android:shadowRadius="8"
                android:singleLine="true"
                android:text="2026 · 剧情 · 全 50 集 · 9.1"
                android:textColor="@color/white_80"
                android:textSize="14sp" />

        </FrameLayout>

        <!-- 元数据 → 简介：4dp。 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="4dp" />

        <!--
            5.3 简介：最宽 440dp、12sp、行高约 17sp、最多 4 行、超出省略。
            lineSpacingMultiplier=1.2 是 TextView 对 Compose lineHeight=17sp 的等价写法。
        -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/synopsis"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.2"
            android:maxLines="4"
            android:maxWidth="440dp"
            android:shadowColor="#AA000000"
            android:shadowDx="1.2"
            android:shadowDy="1.2"
            android:shadowRadius="6"
            android:text="三个男人一路向西，在公路尽头重新认识了自己。他们带着各自的秘密出发，却在无人区里把话说得比过去十年都清楚。有人在加油站丢了钱包，有人在沙漠里捡回一条狗，还有人把最想说的话留到了最后一句。"
            android:textColor="#BBFFFFFF"
            android:textSize="12sp" />

        <!--
            5.4 真实导演 / 主演：上间距 8dp、12sp、单行省略。
            真实逻辑：详情接口给了才显示；这里是静态占位，方便核对行高和宽度。
        -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/credit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxWidth="440dp"
            android:shadowColor="#AA000000"
            android:shadowDx="1.5"
            android:shadowDy="1.5"
            android:shadowRadius="8"
            android:singleLine="true"
            android:text="导演：韩寒 · 主演：冯绍峰 / 陈柏霖 / 钟汉良"
            android:textColor="@color/white_80"
            android:textSize="12sp" />

        <!--
            5.5 加载 / 失败 / 空态：默认 GONE。
            真实逻辑按 DetailState 切换可见性；这里保留 View 挂载点，不接数据。
        -->
        <LinearLayout
            android:id="@+id/loadingRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/loadingSpinner"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/hero_accent" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:includeFontPadding="false"
                android:text="正在加载剧集…"
                android:textColor="@color/white_80"
                android:textSize="12sp" />

        </LinearLayout>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/stateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:maxWidth="440dp"
            android:text="详情加载失败，按「播放」重试"
            android:textColor="#FFFF8A80"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- 5.6 按钮组：上间距 12dp，按钮之间 12dp。默认焦点落在「播放」。 -->
        <LinearLayout
            android:id="@+id/actionRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/actionPlay"
                style="@style/Widget.HeroDetail.ActionButton"
                android:drawableStart="@drawable/ic_widget_play"
                android:nextFocusDown="@id/castItem0"
                android:text="播放" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/actionChangeSource"
                style="@style/Widget.HeroDetail.ActionButton"
                android:layout_marginStart="12dp"
                android:drawableStart="@drawable/ic_detail_change"
                android:nextFocusDown="@id/castItem0"
                android:text="换源" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/actionKeep"
                style="@style/Widget.HeroDetail.ActionButton"
                android:layout_marginStart="12dp"
                android:drawableStart="@drawable/ic_detail_keep_off"
                android:nextFocusDown="@id/castItem0"
                android:text="收藏" />

        </LinearLayout>

        <!-- 5.7 演职员区：上间距 16dp，标题 14sp，标题 → 列表 10dp。 -->
        <LinearLayout
            android:id="@+id/castSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="4dp"
                    android:layout_height="16dp"
                    android:background="@drawable/shape_hero_section_bar" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:text="导演 / 主演"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!--
                横向列表：真实页面是 RecyclerView / LazyRow；
                静态骨架用 HorizontalScrollView + 10 个固定项，方便在电视上一次看全。
                列表尾部额外 24dp，对应 Compose contentPadding end = HERO_PADDING。
            -->
            <HorizontalScrollView
                android:id="@+id/castScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:focusable="false"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/castList"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:paddingEnd="24dp">

                    <LinearLayout
                        android:id="@+id/castItem0"
                        style="@style/Widget.HeroDetail.CastItem"
                        android:nextFocusUp="@id/actionPlay">

                        <FrameLayout style="@style/Widget.HeroDetail.CastAvatarFrame">
                            <androidx.appcompat.widget.AppCompatImageView style="@style/Widget.HeroDetail.CastAvatar" />
                        </FrameLayout>

                        <androidx.appcompat.widget.AppCompatTextView
                            style="@style/Widget.HeroDetail.CastName"
                            android:text="李海潮" />

                    </LinearLayout>

                    <View style="@style/Widget.HeroDetail.CastGap" />

                    <LinearLayout style="@style/Widget.HeroDetail.CastItem">

                        <FrameLayout style="@style/Widget.HeroDetail.CastAvatarFrame">
                            <androidx.appcompat.widget.AppCompatImageView style="@style/Widget.HeroDetail.CastAvatar" />
                        </FrameLayout>

                        <androidx.appcompat.widget.AppCompatTextView
                            style="@style/Widget.HeroDetail.CastName"
                            android:text="陈屿" />

                    </LinearLayout>

                    <View style="@style/Widget.HeroDetail.CastGap" />

                    <LinearLayout style="@style/Widget.HeroDetail.CastItem">

                        <FrameLayout style="@style/Widget.HeroDetail.CastAvatarFrame">
                            <androidx.appcompat.widget.AppCompatImageView style="@style/Widget.HeroDetail.CastAvatar" />
                        </FrameLayout>

                        <androidx.appcompat.widget.AppCompatTextView
                            style="@style/Widget.HeroDetail.CastName"
                            android:text="林晚舟" />

                    </LinearLayout>

                    <View style="@style/Widget.HeroDetail.CastGap" />

                    <LinearLayout style="@style/Widget.HeroDetail.CastItem">

                        <FrameLayout style="@style/Widget.HeroDetail.CastAvatarFrame">
                            <androidx.appcompat.widget.AppCompatImageView style="@style/Widget.HeroDetail.CastAvatar" />
                        </FrameLayout>

                        <androidx.appcompat.widget.AppCompatTextView
                            style="@style/Widget.HeroDetail.CastName"
                            android:text="周野" />

                    </LinearLayout>

                    <View style="@style/Widget.HeroDetail.CastGap" />

                    <LinearLayout style="@style/Widget.HeroDetail.CastItem">

                        <FrameLayout style="@style/Widget.HeroDetail.CastAvatarFrame">
                            <androidx.appcompat.widget.AppCompatImageView style="@style/Widget.HeroDetail.CastAvatar" />
                        </FrameLayout>

                        <androidx.appcompat.widget.AppCompatTextView
                            style="@style/Widget.HeroDetail.CastName"
                            android:text="苏见月" />

                    </LinearLayout>

                    <View style="@style/Widget.HeroDetail.CastGap" />

                    <LinearLayout style="@style/Widget.HeroDetail.CastItem">

                        <FrameLayout style="@style/Widget.HeroDetail.CastAvatarFrame">
                            <androidx.appcompat.widget.AppCompatImageView style="@style/Widget.HeroDetail.CastAvatar" />
                        </FrameLayout>

                        <androidx.appcompat.widget.AppCompatTextView
                            style="@style/Widget.HeroDetail.CastName"
                            android:text="顾云深" />

                    </LinearLayout>

                    <View style="@style/Widget.HeroDetail.CastGap" />

                    <LinearLayout style="@style/Widget.HeroDetail.CastItem">

                        <FrameLayout style="@style/Widget.HeroDetail.CastAvatarFrame">
                            <androidx.appcompat.widget.AppCompatImageView style="@style/Widget.HeroDetail.CastAvatar" />
                        </FrameLayout>

                        <androidx.appcompat.widget.AppCompatTextView
                            style="@style/Widget.HeroDetail.CastName"
                            android:text="沈青禾" />

                    </LinearLayout>

                    <View style="@style/Widget.HeroDetail.CastGap" />

                    <LinearLayout style="@style/Widget.HeroDetail.CastItem">

                        <FrameLayout style="@style/Widget.HeroDetail.CastAvatarFrame">
                            <androidx.appcompat.widget.AppCompatImageView style="@style/Widget.HeroDetail.CastAvatar" />
                        </FrameLayout>

                        <androidx.appcompat.widget.AppCompatTextView
                            style="@style/Widget.HeroDetail.CastName"
                            android:text="许知白" />

                    </LinearLayout>

                    <View style="@style/Widget.HeroDetail.CastGap" />

                    <LinearLayout style="@style/Widget.HeroDetail.CastItem">

                        <FrameLayout style="@style/Widget.HeroDetail.CastAvatarFrame">
                            <androidx.appcompat.widget.AppCompatImageView style="@style/Widget.HeroDetail.CastAvatar" />
                        </FrameLayout>

                        <androidx.appcompat.widget.AppCompatTextView
                            style="@style/Widget.HeroDetail.CastName"
                            android:text="叶南" />

                    </LinearLayout>

                    <View style="@style/Widget.HeroDetail.CastGap" />

                    <LinearLayout style="@style/Widget.HeroDetail.CastItem">

                        <FrameLayout style="@style/Widget.HeroDetail.CastAvatarFrame">
                            <androidx.appcompat.widget.AppCompatImageView style="@style/Widget.HeroDetail.CastAvatar" />
                        </FrameLayout>

                        <androidx.appcompat.widget.AppCompatTextView
                            style="@style/Widget.HeroDetail.CastName"
                            android:text="宋一诺" />

                    </LinearLayout>

                </LinearLayout>

            </HorizontalScrollView>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
