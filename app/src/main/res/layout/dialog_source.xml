<?xml version="1.0" encoding="utf-8"?>
<!--
  照搬 ref_docs/dialog_source.xml（原版 SourceDialog）。
  仅三处必要替换，其余尺寸 / 边距 / 背景 / 文案全部逐字保留：
  1. HorizontalGridView → RecyclerView（libs.leanback 只在 leanbackImplementation，main 源集不能用）；
  2. TypingDotsView → ProgressBar（工程无 com.fongmi.android.tv.ui.custom.TypingDotsView）；
  3. siteLayout 由 invisible 改 visible（Hero 版需要常显站点栏，原版此时由代码控制显隐）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/shape_dialog_source_shell"
    android:padding="18dp"
    android:paddingBottom="0dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginBottom="8dp">
        <TextView
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/badge"
            android:background="@drawable/shape_tmdb_badge"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:text="@string/play_change"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"/>
        <!--
          「⬅️ 返回」：只在 folder 下探时由 ChangeSourceDialog.syncDrillUi() 显示。
          放在 badge 之后、结果计数之前，进入目录后焦点直接落到这里。
        -->
        <TextView
            android:id="@+id/backBtn"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:text="⬅️ 返回"
            android:background="@drawable/selector_source_site_chip_background"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:clickable="true"
            android:nextFocusDown="@+id/recycler"
            android:nextFocusRight="@+id/recycler"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginStart="10dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/keywordRow"
            android:nextFocusDown="@+id/siteRecycler"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:overScrollMode="never"
            android:layout_marginStart="10dp"
            android:visibility="gone"/>
        <TextView
            android:textSize="11sp"
            android:textColor="#59ffffff"
            android:id="@+id/resultCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/siteLayout"
        android:visibility="visible"
        android:clipChildren="true"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginBottom="8dp"
        android:baselineAligned="false">
        <FrameLayout
            android:id="@+id/homeBtn"
            android:background="@drawable/selector_home_logo_source"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusRight="@+id/siteRecycler"
            android:nextFocusUp="@+id/keywordRow"
            android:nextFocusDown="@+id/recycler"
            android:clickable="true"
            android:layout_width="26dp"
            android:layout_height="26dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_home_logo"/>
        </FrameLayout>
        <FrameLayout
            android:clipChildren="true"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/siteRecycler"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:nextFocusLeft="@+id/homeBtn"
                android:nextFocusUp="@+id/keywordRow"
                android:nextFocusDown="@+id/recycler"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="4dp"
                android:paddingEnd="8dp"/>
        </FrameLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">
        <View
            android:background="@drawable/shape_red_bar"
            android:layout_width="3dp"
            android:layout_height="14dp"/>
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#99ffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/play_change_result"
            android:layout_marginStart="8dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#99ffffff"
            android:ellipsize="marquee"
            android:id="@+id/panTitle"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_weight="1"
            android:marqueeRepeatLimit="marquee_forever"
            android:layout_marginStart="12dp"/>
    </LinearLayout>
    <!--
      结果区：mLayout weight 吃掉头部 / 站点栏 / 标题行剩下的全部高度。
      卡片整高 214dp + recycler 的 paddingTop 4dp = 218dp，由
      ChangeSourceDialog.setupWindow() 抬高弹窗窗口高度来保证；
      这里不能再写 minHeight / 固定高度 —— 0dp + weight 下 minHeight 会被
      LinearLayout 的 EXACTLY 测量直接忽略，写了也只是假保险。
    -->
    <FrameLayout
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <ProgressBar
            android:layout_gravity="top|center_horizontal"
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="86dp"
            android:indeterminateTint="@color/white"
            android:visibility="gone"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#59ffffff"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/empty"
            android:padding="16dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/play_change_empty"/>
        <!--
          结果卡横向列表。原版（ref_docs/dialog_source.xml）左右内边距是 8dp / 2dp：
          它用 HorizontalGridView，焦点放大由控件自己处理、不会画出边界。这里换成普通
          RecyclerView + itemView 1.08 放大，卡片会向两侧各多出约 2.4dp，2dp 的右内边距
          会把最后一张卡的白框切掉，所以左右统一放到 24dp（等价于 Compose LazyRow 的
          contentPadding = 24.dp），配合 clipToPadding / clipChildren = false，
          滚动到首尾时卡片与白框都完整可见。
        -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:paddingTop="4dp"
            android:paddingBottom="0dp"
            android:visibility="gone"
            android:nextFocusUp="@+id/siteRecycler"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"/>
    </FrameLayout>
</LinearLayout>
