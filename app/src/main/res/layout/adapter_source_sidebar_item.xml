<?xml version="1.0" encoding="utf-8"?>
<!--
  接口源侧边栏列表行（需求中的 adapter_site_view.xml；本工程实际文件名为 adapter_source_sidebar_item.xml）。

  结构严格按逆向原版 adapter_site.xml + s82.java：
  - 根 FrameLayout 就是可聚焦的行本体，高 40dp，背景 selector_site_item_background；
    单选 / 多选共用同一套行布局；
  - 文字 width=0dp + weight=1 + gravity=center + 18sp，横向占满文字区并居中；
    焦点时 selector_site_item_text 把文字反转为纯黑 #000000，其余状态纯白 #FFFFFF；
  - 右侧 MaterialCheckBox 20×20dp（原版 24dp，按需求缩小），
    enabled/focusable/clickable 全部 false，只作为状态显示；
    android:button 指向 selector_site_item_check，画出白色空心圆 / 白色实心带勾，
    行聚焦白胶囊上自动切黑色版本，避免白圈白底看不见；
  - 行底 1dp View 使用原版 shape_line_tapered（左右透明、中间 10% 白），
    左右各 24dp；焦点胶囊 inset 上下 4dp，下划线落在胶囊之外，不会被白底吞掉。

  为什么不用 LinearLayout 做根：文字需要 weight=1，而 1dp 下划线要压在行底，
  FrameLayout 根 + 内部横向 LinearLayout 能同时满足「weight 居中」和「底部叠线」。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/item"
    android:layout_width="match_parent"
    android:layout_height="40dp"
    android:background="@drawable/selector_site_item_background"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/text"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:duplicateParentState="true"
            android:ellipsize="marquee"
            android:focusable="false"
            android:gravity="center"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="@color/selector_site_item_text"
            android:textSize="18sp" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/check"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:background="@null"
            android:button="@drawable/selector_site_item_check"
            android:buttonTint="@null"
            android:clickable="false"
            android:duplicateParentState="true"
            android:enabled="false"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:gravity="center"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            app:buttonTint="@null" />
    </androidx.appcompat.widget.LinearLayoutCompat>

    <View
        android:id="@+id/line"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/shape_line_tapered" />

</FrameLayout>
