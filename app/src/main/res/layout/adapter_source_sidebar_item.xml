<?xml version="1.0" encoding="utf-8"?>
<!--
  接口源侧边栏列表行。尺寸与排版逐字照抄逆向 `adapter_search_site.xml`（图1 的实际行布局）。

  - 行 = `@id/item` 横向 LinearLayoutCompat：高 39dp、宽 match_parent、weightSum=94，
    背景 selector_site_item_background（焦点白胶囊）；
  - 行内五段固定比例（权重总和 94）：左空 14 / 文字 60 / 间隔 8 / 圆圈列 24dp / 右空 12。
    文字因此严格居中在自己的 60 格里，圆圈紧贴在文字右侧，右侧再留 12 格呼吸位；
  - 文字：0dp + weight=60 + 14sp + gravity=center + singleLine + marquee；
  - 圆圈列：24dp 固定宽（不参与权重），里面居中一颗 20dp 的 `@id/check`，
    背景 selector_check_circle，靠 duplicateParentState 继承行的 focused / selected：
    selected → 环 + 对勾，未 selected → 空心环；行聚焦白胶囊上自动转黑；
  - 行底 1dp shape_line_tapered 下划线，左右各 12dp，落在白胶囊之外。

  【状态链】根是纵向容器（行 + 下划线），可聚焦的是里面的 `@id/item`；
  文字与圆圈列的 duplicateParentState 复制的就是它的状态，
  所以白胶囊、黑字、黑圈三者永远同步，不会出现白底白字。
-->
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/item"
        android:layout_width="match_parent"
        android:layout_height="39dp"
        android:background="@drawable/selector_site_item_background"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:weightSum="94">

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="14" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="60"
            android:duplicateParentState="true"
            android:ellipsize="marquee"
            android:focusable="false"
            android:gravity="center"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="@color/selector_site_item_text"
            android:textSize="14sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="8" />

        <FrameLayout
            android:layout_width="24dp"
            android:layout_height="match_parent"
            android:duplicateParentState="true">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/check"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:background="@drawable/selector_check_circle"
                android:duplicateParentState="true" />
        </FrameLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="12" />
    </androidx.appcompat.widget.LinearLayoutCompat>

    <View
        android:id="@+id/line"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/shape_line_tapered" />

</androidx.appcompat.widget.LinearLayoutCompat>
