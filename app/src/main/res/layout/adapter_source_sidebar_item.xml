<?xml version="1.0" encoding="utf-8"?>
<!--
  照搬 ref_docs/adapter_site.xml（原版 SiteDialog 列表行，由 s82 SitePresenter 绑定）：
  行高 40dp、18sp 文字、24dp 勾选圈（layout_marginStart 12dp）、行底 1dp 渐隐分隔线。

  唯一替换：原版勾选圈是
    MaterialCheckBox(enabled=false, button=@drawable/check_circle, app:buttonTint=@color/selector_site_item_check)
  这两个资源（check_circle / selector_site_item_check）在本工程不存在，
  改用 ref_docs 同源的 @drawable/selector_check_circle + AppCompatImageView（四态、24dp 不变）。
  其余结构、尺寸、颜色、选择器全部原样。
-->
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/item"
        android:background="@drawable/selector_source_site_item_background"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="match_parent"
        android:layout_height="40dp">
        <com.google.android.material.textview.MaterialTextView
            android:textSize="18sp"
            android:textColor="@color/selector_source_site_item_text"
            android:ellipsize="marquee"
            android:gravity="center"
            android:id="@+id/text"
            android:focusable="false"
            android:duplicateParentState="true"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:layout_weight="1"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/check"
            android:duplicateParentState="true"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/selector_check_circle"
            android:layout_marginStart="12dp"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <View
        android:id="@+id/line"
        android:background="@drawable/shape_line_tapered"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="24dp"
        android:layout_marginHorizontal="24dp"/>
</androidx.appcompat.widget.LinearLayoutCompat>
