<?xml version="1.0" encoding="utf-8"?>
<!--
  接口源侧边栏列表行（单列 / 多选共用同一套行布局）。

  尺寸取自 ref_docs/adapter_site.xml：40dp 行高、18sp 文字、24dp 勾选圈（marginStart 12dp）。

  **根节点就是可聚焦的行本体**：原版是「外层容器 + 内层 @id/item」两层，
  adapter 通过 itemView 设置 isSelected / 焦点，若背景和 focusable 在内层，
  选中态就落不到画背景的 View 上，行永远没有高亮。合并成一层后状态必然生效。

  颜色（按需求指定）：
  - focused：白底 #FFFFFF + 黑字 #000000，圆角矩形（selector_source_site_item_background
    → shape_source_site_item_focused，inset 8dp/4dp + 28dp 圆角，取自 ref_docs）
  - normal：透明底 + 白字（shape_source_chip_round_normal 无 solid）
  - 勾选圈用 selector_check_circle 四态；SingleChoice 模式由代码置 GONE。
-->
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/selector_source_site_item_background"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:layout_width="match_parent"
    android:layout_height="40dp"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">
    <com.google.android.material.textview.MaterialTextView
        android:textSize="18sp"
        android:textColor="@color/selector_source_site_item_text"
        android:ellipsize="marquee"
        android:gravity="center"
        android:id="@+id/text"
        android:focusable="false"
        android:duplicateParentState="true"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:singleLine="true"
        android:includeFontPadding="false"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/check"
        android:duplicateParentState="true"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/selector_check_circle"/>
</androidx.appcompat.widget.LinearLayoutCompat>
