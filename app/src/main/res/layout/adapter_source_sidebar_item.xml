<?xml version="1.0" encoding="utf-8"?>
<!--
  照搬 ref_docs/adapter_site.xml（站点选择列表行：40dp / 18sp / 24dp 勾选圈）。
  两处替换：
  1. MaterialCheckBox + @drawable/check_circle + @color/selector_site_item_check（本工程均缺失）
     → AppCompatImageView + @drawable/selector_check_circle（ref_docs 同源的四态选择器）；
  2. 行宽与文字宽度由 match_parent / weight 改为 wrap_content：原版是整宽 sheet，
     Hero 侧边栏的宽度由内容决定，否则面板会被撑到整屏；
  3. 行底部的 shape_line_tapered 分隔线删除：match_parent 宽的 1dp View 在 wrap_content
     面板里同样会把面板撑到整屏。
-->
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/item"
        android:background="@drawable/selector_source_site_item_background"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">
        <com.google.android.material.textview.MaterialTextView
            android:textSize="18sp"
            android:textColor="@color/selector_source_site_item_text"
            android:ellipsize="marquee"
            android:gravity="center"
            android:id="@+id/text"
            android:focusable="false"
            android:duplicateParentState="true"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:singleLine="true"
            android:includeFontPadding="false"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/check"
            android:duplicateParentState="true"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/selector_check_circle"
            android:layout_marginStart="12dp"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.appcompat.widget.LinearLayoutCompat>
