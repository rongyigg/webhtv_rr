<?xml version="1.0" encoding="utf-8"?>
<!--
    HeroUI 历史页（View 体系）。

    真值来源：ref_docs/fragment_history.xml（节点顺序、尺寸、字号、颜色、阴影全部照抄），
    只做了三处「必须」的替换：
    1. `androidx.leanback.widget.HorizontalGridView` → `androidx.recyclerview.widget.RecyclerView`
       （main 源集禁止 import leanback，见 AGENTS.md）；
    2. 卡片不再用 `adapter_history_poster.xml`，改为全局唯一组件 HeroPosterCard
       （120×214、四角 8dp、2dp #FFFF0000 焦点框），由代码直接 addView；
    3. 遮罩 `bg_hero_mask_h` / `bg_hero_mask_v` 在 main 里不存在（首页是 Compose 渐变），
       这里用 HeroMaskLeftView / HeroMaskBottomView 按同一组色标自绘，颜色与首页 100% 一致。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- fragment_history.xml L6-19 heroBgUnder / heroBg：全屏背景大图 -->
    <ImageView
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <!-- fragment_history.xml L20-31 maskLeft / maskBottom：与首页 Compose 同色标 -->
    <com.fongmi.android.tv.ui.activity.HeroMaskLeftView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.fongmi.android.tv.ui.activity.HeroMaskBottomView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- fragment_history.xml L72-240 posterContent：贴底内容列 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <!-- fragment_history.xml L81-146 heroInfo：左右 24dp、底 22dp -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="22dp"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <!-- L90-102 heroNameText：32sp 粗体、高 36dp、贴底、阴影 #cc000000 2/2/12 -->
            <TextView
                android:id="@+id/heroName"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:ellipsize="end"
                android:gravity="bottom"
                android:maxLines="1"
                android:shadowColor="#cc000000"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="12"
                android:textColor="@color/white"
                android:textSize="32sp"
                android:textStyle="bold" />

            <!-- L111-123 heroMetaText：14sp、#ccffffff、高 20dp、marginTop 2dp、阴影 #aa000000 1.5/1.5/8 -->
            <TextView
                android:id="@+id/heroMeta"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:gravity="bottom"
                android:maxLines="1"
                android:shadowColor="#aa000000"
                android:shadowDx="1.5"
                android:shadowDy="1.5"
                android:shadowRadius="8"
                android:textColor="#ccffffff"
                android:textSize="14sp" />

            <!-- L124-145：外层 weightSum=2 + 子项 weight=1 → 简介只占一半宽度 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:weightSum="2">

                <!-- L130-144 heroDescText：12sp、#bbffffff、高 40dp、2 行、行距 3dp、阴影 #aa000000 1.2/1.2/6 -->
                <TextView
                    android:id="@+id/heroDesc"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:lineSpacingExtra="3dp"
                    android:maxLines="2"
                    android:shadowColor="#aa000000"
                    android:shadowDx="1.2"
                    android:shadowDy="1.2"
                    android:shadowRadius="6"
                    android:textColor="#bbffffff"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- fragment_history.xml L147-220 resumeRow：左右 24dp、底 22dp -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="22dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <!-- L158-173 btnResume：14sp、高 32dp，确定键进详情页；↓ 进海报行 -->
            <TextView
                android:id="@+id/btnResume"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/selector_hero_resume"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:nextFocusDown="@+id/recycler"
                android:text="@string/hero_history_view_detail"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <!-- L174-219 progressGroup：宽 200dp、距按钮 20dp -->
            <LinearLayout
                android:id="@+id/progressGroup"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- L187-199 progressEpisode：当前集号（E02） -->
                    <TextView
                        android:id="@+id/progressEpisode"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:includeFontPadding="false"
                        android:shadowColor="#aa000000"
                        android:shadowDx="1"
                        android:shadowDy="1"
                        android:shadowRadius="4"
                        android:singleLine="true"
                        android:textColor="#ccffffff"
                        android:textSize="12sp" />

                    <!-- L200-212 progressTotal：已看 / 总时长（27:15 / 47:34） -->
                    <TextView
                        android:id="@+id/progressTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:shadowColor="#aa000000"
                        android:shadowDx="1"
                        android:shadowDy="1"
                        android:shadowRadius="4"
                        android:textColor="#ccffffff"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- L214-218 progressBar：高 2dp、marginTop 2dp -->
                <ProgressBar
                    android:id="@+id/progressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginTop="2dp"
                    android:max="1000"
                    android:progressDrawable="@drawable/progress_hero_history" />
            </LinearLayout>
        </LinearLayout>

        <!-- fragment_history.xml L221-238：整行 215dp，左右各 24dp，卡片可以出血到边缘 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="215dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- HorizontalGridView → RecyclerView（LinearLayoutManager.HORIZONTAL，代码里设置） -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler"
                android:layout_width="match_parent"
                android:layout_height="215dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:focusable="false"
                android:nextFocusUp="@+id/btnResume"
                android:overScrollMode="never"
                android:paddingStart="24dp"
                android:paddingEnd="24dp" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
