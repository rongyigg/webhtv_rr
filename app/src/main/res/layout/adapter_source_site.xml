<?xml version="1.0" encoding="utf-8"?>
<!--
  换源弹窗（ChangeSourceDialog）顶部站点标签。

  结构取自 ref_docs/adapter_v2_site.xml，但**根节点就是可聚焦的标签本体**：
  原版是「外层容器 + 内层 @id/item」两层，本工程由 RecyclerView.ViewHolder 直接操作
  itemView，若把背景/focusable 放在内层，adapter 设置的 isSelected 会落在不画背景的外层，
  焦点态也就永远不会绘制。合并成一层后 itemView 即标签，状态一定生效。

  颜色（按需求指定）：
  - focused：红底 #E50914（@color/red）+ 白字，胶囊圆角 28dp（见 selector_source_site_chip_background）
  - normal / selected：透明底 + 白字
-->
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/selector_source_site_chip_background"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:layout_width="wrap_content"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14sp"
        android:textColor="@color/white"
        android:ellipsize="marquee"
        android:gravity="center"
        android:id="@+id/text"
        android:duplicateParentState="true"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:singleLine="true"
        android:includeFontPadding="false"/>
</androidx.appcompat.widget.LinearLayoutCompat>
