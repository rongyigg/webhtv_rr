<?xml version="1.0" encoding="utf-8"?>
<!--
    手动 TMDB 匹配弹窗（纯 View，禁止 Compose）。

    完全对齐逆向 `ref_docs/dialog_tmdb_match.xml`：
    - 顶部一行：TMDB 徽标 + 联想词横向列表（@id/suggestion）+ 右侧「第 N 季」胶囊（默认 gone）；
    - 左侧 217dp：输入框 @id/keyword + 放大镜按钮 @id/searchBtn + 6 列虚拟键盘 @id/keyboard；
    - 右侧自适应：红条 + 「匹配结果」标题 + 结果计数，210dp 高的海报区 @id/candidate。

    焦点流转（对应逆向 `TmdbMatchDialog.g0()`）：
    - 输入框 nextFocusDown → 键盘（按下进第一排）；
    - 键盘最右列按右由 `TmdbKeyboardAdapter` 拦截后跳到 @id/candidate；
    - 海报卡片的 nextFocusLeftId 在 `TmdbMatchViewDialog` 里统一设成 @id/searchBtn（严格照抄 g0()）；
    - 海报卡片 nextFocusUp → 键盘（回到第一排）。

    输入框不允许弹系统键盘：showSoftInputOnFocus=false，对话框窗口再加 FLAG_ALT_FOCUSABLE_IM。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/shape_tmdb_match_shell"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical"
    android:padding="18dp">

    <!--
        顶栏固定 36dp：联想词胶囊高度 28dp + 上下各 4dp，整体高度恒定。
        不管联想词出现 / 消失 / 从 1 条变成 10 条，弹窗高度都不再抖动。
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginBottom="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tmdbBadge"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:background="@drawable/shape_tmdb_badge"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/home_tmdb_match"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/suggestion"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:nextFocusDown="@+id/keyword"
            android:overScrollMode="never" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/seasonTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/shape_season_tag"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:visibility="gone"
            tools:text="第 2 季"
            tools:visibility="visible" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- 左列：217dp，输入区 + 6 列虚拟键盘 -->
        <LinearLayout
            android:layout_width="217dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/keyword"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:background="@drawable/selector_tmdb_input"
                    android:gravity="start|center_vertical"
                    android:hint="@string/home_tmdb_match_hint"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:nextFocusDown="@+id/keyboard"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    tools:text="嫁金钗" />

                <!--
                    放大镜对齐键盘第一排第 2 个字母（B）：
                    键盘 6 列 = 6×30dp + 5×5dp 间距 = 205dp，在 217dp 左列里居中 → 左缩进 6dp，
                    B 键占 181~211dp、中心 196dp；
                    按钮 32dp 宽，加 marginEnd 5dp 后占 180~212dp、中心正好也是 196dp。
                    输入框同时被压短 5dp（weight=1 自动让位），不再顶到列尾。
                -->
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/searchBtn"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/selector_tmdb_search"
                    android:contentDescription="@string/home_tmdb_match"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:padding="4dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_keyboard_search" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/keyboard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:nextFocusDown="@+id/candidate"
                android:overScrollMode="never"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="6" />
        </LinearLayout>

        <!-- 右列：结果标题 + 210dp 海报区 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="3dp"
                    android:layout_height="14dp"
                    android:background="@drawable/shape_red_bar" />

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:alpha="0.6"
                    android:text="@string/home_tmdb_match_result"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/resultCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:alpha="0.35"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    tools:text="12" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="210dp"
                android:nextFocusUp="@+id/keyboard">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:alpha="0.35"
                    android:gravity="center"
                    android:padding="16dp"
                    android:text="@string/home_tmdb_match_empty"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <!--
                    防裁切：clipChildren / clipToPadding 都为 false，1.08 倍放大的海报不会被列表边界切掉；
                    左侧 8dp paddingStart 给第一张卡片的放大留出余量（逆向 HorizontalGridView 也是 8 的倍数）。
                -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/candidate"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:nextFocusUp="@+id/keyboard"
                    android:overScrollMode="never"
                    android:paddingStart="8dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="2dp" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
