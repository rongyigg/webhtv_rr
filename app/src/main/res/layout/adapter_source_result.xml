<?xml version="1.0" encoding="utf-8"?>
<!--
  换源弹窗（ChangeSourceDialog）结果卡片 —— 严格照抄 ref_docs/adapter_search.xml。

  逆向结构：
  ┌ RelativeLayout                根节点 focusable，foreground=@drawable/selector_vod
  │   ├ ShapeableImageView @id/image   海报，@color/black_20 + @style/Vod.Grid（仅上方两角 8dp）
  │   ├ TextView          @id/site    13sp、@drawable/shape_vod_site、maxWidth 96dp、单行
  │   ├ TextView          @id/remark  14sp、@drawable/shape_vod_remark，位于 @id/name 正上方、与海报底边对齐
  │   └ TextView          @id/name    16sp、@drawable/shape_vod_name、padding 6dp、gravity center、单行
  └

  本工程内已做的替换（逐条注明）：
  1. selector_vod      → @drawable/selector_source_card_foreground（focused = 1.5dp 纯白描边）
     shape_vod_name    → @drawable/shape_source_vod_name（black_20 + 下方两角 8dp）
     两者在 main 源集不存在，按 source_ 前缀重建等价资源，数值逐字照抄。
  2. 海报无真实地址 → src 用 @drawable/shape_source_poster_placeholder（红→金 45° 渐变），
     正中叠 @id/placeholder 显示剧名首字；接真实海报时把它置 GONE 即可。
  3. @id/site 原版 visibility="gone"，这里常显并承载「日期 | 来源」；maxWidth 由 96dp 放宽到
     120dp（卡片全宽），否则 13sp 的「2026-10-28 | 豆瓣」会被截断。

  尺寸说明（逆向里 image 是 match_parent × 0dp，高度由外层决定，本身没有写死比例）：
  卡片宽 120dp，海报 120×160（3:4）。**不能更高**：弹窗高度 = min(360dp, 屏高×0.65)，
  下方结果区实际可用约 220dp，海报 180dp 时卡片总高约 214dp，焦点放大 1.08 倍后
  230dp+ 会超出结果区，白色焦点框就会把底部剧名切掉 —— 这正是上一版的实际问题。
  160dp 时卡片总高约 193dp，×1.08 ≈ 208dp，留出余量，剧名永远完整。
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:foreground="@drawable/selector_source_card_foreground"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="120dp"
    android:layout_height="wrap_content"
    android:stateListAnimator="@null"
    android:outlineProvider="none"
    android:defaultFocusHighlightEnabled="false">

    <!-- 上半部分：海报容器（固定 120×160） -->
    <FrameLayout
        android:id="@+id/imageWrapper"
        android:duplicateParentState="true"
        android:clipChildren="true"
        android:clipToPadding="false"
        android:layout_width="120dp"
        android:layout_height="160dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/image"
            android:background="@color/black_20"
            android:src="@drawable/shape_source_poster_placeholder"
            android:scaleType="centerCrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:shapeAppearanceOverlay="@style/Vod.Grid" />

        <!-- 无海报时的首字占位：海报正中央 -->
        <TextView
            android:id="@+id/placeholder"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="#F2FFFFFF"
            android:gravity="center"
            android:layout_gravity="center"
            android:includeFontPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <!-- 左上角：「日期 | 来源」，13sp（逆向 @id/site 的原字号） -->
        <TextView
            android:id="@+id/site"
            android:textSize="13sp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:background="@drawable/shape_vod_site"
            android:gravity="center"
            android:maxWidth="120dp"
            android:singleLine="true"
            android:layout_gravity="start|top"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <!-- 海报内偏下：「更新至XX集」，14sp（逆向 @id/remark 的原字号），
             位置等价于原版 layout_above="@+id/name" + 与海报底边对齐 -->
        <TextView
            android:id="@+id/remark"
            android:textSize="14sp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:background="@drawable/shape_vod_remark"
            android:singleLine="true"
            android:maxWidth="112dp"
            android:layout_gravity="start|bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </FrameLayout>

    <!-- 下半部分：剧名，16sp + shape_source_vod_name + padding 6dp + 单行省略 -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/name"
        android:textSize="16sp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:gravity="center"
        android:background="@drawable/shape_source_vod_name"
        android:padding="6dp"
        android:singleLine="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/imageWrapper"
        android:layout_alignStart="@+id/imageWrapper"
        android:layout_alignEnd="@+id/imageWrapper" />

</RelativeLayout>
