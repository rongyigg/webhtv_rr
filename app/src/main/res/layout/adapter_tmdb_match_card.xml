<?xml version="1.0" encoding="utf-8"?>
<!--
    手动 TMDB 匹配弹窗：右侧海报卡片。
    108dp 宽 + 间距 12dp = 每张占 120dp；右侧可视区约 512dp，
    4 张刚好占满 480dp，第 5 张露出 32dp ≈ 三分之一张（卡片自带 4dp 内边距，视觉间隙 20dp）。

    焦点框直接复用首页海报卡片的 @drawable/selector_vod（= leanback adapter_vod.xml 的 foreground，
    1.5dp @color/osd_focus + 8dp 圆角），不自己画细线红框；selector 只有 state_focused 一项，
    未聚焦时不绘制任何东西，因此不会给卡片加额外边框；1.08 缩放动画在 itemView 上，foreground 跟着一起缩放。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="108dp"
    android:layout_height="wrap_content"
    android:background="@null"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:defaultFocusHighlightEnabled="false"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:foreground="@drawable/selector_vod"
    android:gravity="center_horizontal"
    android:nextFocusUp="@id/keyboard"
    android:orientation="vertical"
    android:padding="4dp"
    android:stateListAnimator="@null">

    <FrameLayout
        android:id="@+id/imageWrapper"
        android:layout_width="100dp"
        android:layout_height="150dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:duplicateParentState="true">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/black_20"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/Vod.Grid.Large" />
    </FrameLayout>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:ellipsize="marquee"
        android:gravity="center"
        android:singleLine="true"
        android:textColor="@color/white"
        android:textSize="12sp"
        tools:text="嫁金钗" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:alpha="0.4"
        android:ellipsize="marquee"
        android:gravity="center"
        android:singleLine="true"
        android:textColor="@color/white"
        android:textSize="10sp"
        tools:text="2024 · TV" />
</LinearLayout>
