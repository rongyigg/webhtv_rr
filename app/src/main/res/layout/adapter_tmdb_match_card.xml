<?xml version="1.0" encoding="utf-8"?>
<!--
    手动 TMDB 匹配弹窗：右侧海报卡片。

    焦点红框严格贴在 @id/imageWrapper（海报本身）上，**不覆盖也不框住标题 / 年份两行文字**：
      - 根 LinearLayout 不再挂任何 foreground；
      - imageWrapper 用 android:duplicateParentState="true" 复刻父容器的 focused 状态，
        因此它自己拿到 state_focused 就能着色，无需 focusable；
      - 红框资源直接复用首页 View 海报卡的 @drawable/selector_vod
        （leanback adapter_vod.xml 的 foreground = 1.5dp @color/osd_focus + 8dp 圆角）。

    尺寸照旧：108dp 宽卡片 + 8dp 间距（逆向 b0() 的 setHorizontalSpacing(g2.b(8))），
    海报 100x150，卡片自带 4dp 内边距，放大到 1.08 倍时由 candidate 关闭裁剪承接。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="108dp"
    android:layout_height="wrap_content"
    android:background="@null"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:defaultFocusHighlightEnabled="false"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:gravity="center_horizontal"
    android:nextFocusUp="@id/keyboard"
    android:orientation="vertical"
    android:padding="4dp"
    android:stateListAnimator="@null">

    <FrameLayout
        android:id="@+id/imageWrapper"
        android:layout_width="100dp"
        android:layout_height="150dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:duplicateParentState="true"
        android:foreground="@drawable/selector_vod">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/black_20"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/Vod.Grid.Large" />
    </FrameLayout>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:ellipsize="marquee"
        android:gravity="center"
        android:singleLine="true"
        android:textColor="@color/white"
        android:textSize="12sp"
        tools:text="嫁金钗" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:alpha="0.4"
        android:ellipsize="marquee"
        android:gravity="center"
        android:singleLine="true"
        android:textColor="@color/white"
        android:textSize="10sp"
        tools:text="2024 · TV" />
</LinearLayout>
