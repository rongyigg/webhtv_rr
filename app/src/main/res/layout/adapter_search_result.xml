<?xml version="1.0" encoding="utf-8"?>
<!--
    搜索页结果卡（原版 ref_docs/adapter_search.xml + 截图实测 117×215dp）。

    FrameLayout 117×215dp（foreground = 全局海报焦点框 selector_vod，1.5dp 红描边）
    └─ LinearLayout（vertical）
        ├─ FrameLayout 117×181dp：海报 + 左上站点标签 + 左下集数标签
        └─ 剧名 117×34dp：16sp、居中、单行省略

    圆角：整卡背景 shape_search_poster（6dp）+ clipToOutline，海报被同一轮廓裁圆，
    上下圆角一致；名称区就是这层背景本身，不再叠第二块底板。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="117dp"
    android:layout_height="215dp"
    android:background="@drawable/shape_search_poster"
    android:clipToOutline="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:foreground="@drawable/selector_vod">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="181dp">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/black_20"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/site"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:background="@drawable/shape_vod_site"
                android:ellipsize="end"
                android:maxWidth="96dp"
                android:singleLine="true"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:visibility="gone" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/remark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:background="@drawable/shape_vod_remark"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:visibility="gone" />

        </FrameLayout>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:ellipsize="end"
            android:gravity="center"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:singleLine="true"
            android:textColor="@color/white"
            android:textSize="16sp" />

    </androidx.appcompat.widget.LinearLayoutCompat>

</FrameLayout>
