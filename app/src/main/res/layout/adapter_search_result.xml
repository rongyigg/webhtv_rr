<?xml version="1.0" encoding="utf-8"?>
<!--
    搜索页结果卡（原版 `adapter_vod_rect.xml` + `vs3(Style.rect())` 的 rect 卡，尺寸全部来自逆向数据）。

    - 海报 120×180dp（`adapter_vod_rect.xml` L24-25）：7 张卡 + 6 × 12dp 间距 = 912dp，
      正好铺满 912dp 内容区，最左 / 最右卡到屏幕边缘都是 24dp（与原版截图一致）；
    - 剧名 13sp / `white_80` / 居中单行 / marginTop 8dp（同文件 L46-57）；
    - 焦点红框只包海报：`selector_vod` 挂在 `imageWrapper` 上，`duplicateParentState`
      把根节点的 focused 状态透传下来；剧名在框外，所以不会再「框住卡片和字」；
    - 海报圆角 8dp + `clipToOutline`，与焦点框 8dp 半径完全重合（原版 `Vod.Grid.Large` 也是 8dp），
      红框严丝合缝贴住海报，不会再有「框圆卡方 / 卡角溢出框外」；
    - 聚焦放大 1.08（原版 `mm3.f(recyclerView, 1.08f)`），由 `SearchResultAdapter` 挂在根节点上；
    - 左下角集数标签用 `shape_search_remark`：左下角 8dp 跟着海报圆角走，不再露出直角。
-->
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="120dp"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/imageWrapper"
        android:layout_width="120dp"
        android:layout_height="180dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:duplicateParentState="true"
        android:foreground="@drawable/selector_vod">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/shape_search_poster"
            android:clipToOutline="true"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/site"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:background="@drawable/shape_vod_site"
            android:ellipsize="end"
            android:maxWidth="96dp"
            android:singleLine="true"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:visibility="gone" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/remark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:background="@drawable/shape_search_remark"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:visibility="gone" />

    </FrameLayout>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:gravity="center"
        android:singleLine="true"
        android:textColor="@color/white_80"
        android:textSize="13sp" />

</androidx.appcompat.widget.LinearLayoutCompat>
