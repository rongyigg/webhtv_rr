<?xml version="1.0" encoding="utf-8"?>
<!--
  照搬 ref_docs/dialog_site.xml（原版 SiteDialog / kz2）：
  根布局横向、padding 24dp、wrap_content 高度、baselineAligned=false，
  左侧 CustomRecyclerView（weight 1、wrap_content 高、app:maxHeight=480dp）。

  与原版的两处差异：
  1. 原版根布局没有 android:background —— 它由 MaterialAlertDialog 的 surface 提供；
     本工程的换源弹窗是透明主题的独立 Dialog，故用同源的 @drawable/shape_dialog_source。
  2. 原版右侧的 @id/action 图标列（search / sort / change / select / cancel）整列删除：
     它默认就是 gone，而它引用的 selector_config_delete_background、selector_config_item_delete、
     ic_site_sort 在本工程不存在，ic_site_search / ic_site_change / ic_site_select / ic_site_cancel
     只存在于 leanback 与 mobile 源集（main 布局引用会破坏另一个变体的编译）。
-->
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="24dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/shape_dialog_source"
    android:baselineAligned="false">
    <com.fongmi.android.tv.ui.custom.CustomRecyclerView
        android:id="@+id/recycler"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:overScrollMode="never"
        app:maxHeight="480dp"/>
</androidx.appcompat.widget.LinearLayoutCompat>
