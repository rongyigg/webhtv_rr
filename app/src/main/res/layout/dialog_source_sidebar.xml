<?xml version="1.0" encoding="utf-8"?>
<!--
  接口源侧边栏面板。尺寸与排版逐字照抄逆向 `dialog_search_site.xml`（图1 的实际面板）。

  - 根：match_parent × match_parent，深色半透明直角底（shape_dialog_source），
    paddingTop 4dp / paddingBottom 16dp / paddingStart·End 4dp；
  - 顶栏 39dp：两个 0dp + weight=1 的按钮严格等分整行（没有任何左右占位），
    每个按钮 = 12sp 文字 + 6dp 间距 + 16dp 圆圈，水平居中；
    背景 selector_search_action_background：常态半透明胶囊（inset 8dp），
    焦点纯白胶囊 + 黑字；
  - 两个圈都指向 selector_check_circle，靠 duplicateParentState 继承按钮的 selected：
    全选按钮默认 selected（圈内打勾），全不选默认未 selected（空心环），与图1 一致；
  - 顶栏下方 1dp shape_line_tapered 下划线，左右各 12dp；
  - 列表 0dp + weight=1 占满剩余高度，行布局见 adapter_source_sidebar_item.xml。

  宽度不写死：窗口在 SourceSidebar.onStart 的 applyWindowLayout 里按屏宽 ÷ 5 设定，
  根节点 match_parent 跟随窗口，两个 weight=1 的按钮因此天然等分、严格对称。
  高度同样是 match_parent，窗口高度给 MATCH_PARENT，面板从屏幕顶部贴到底部。
-->
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/shape_dialog_source"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingTop="4dp"
    android:paddingEnd="4dp"
    android:paddingBottom="16dp">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/bulkBar"
        android:layout_width="match_parent"
        android:layout_height="39dp"
        android:orientation="horizontal">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/all"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/selector_search_action_background"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:nextFocusDown="@id/recycler"
            android:nextFocusUp="@id/all"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:duplicateParentState="true"
                android:gravity="center"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="@string/source_sidebar_select_all"
                android:textColor="@color/selector_site_item_text"
                android:textSize="12sp" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/allCheck"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/selector_check_circle"
                android:duplicateParentState="true" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/none"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/selector_search_action_background"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:nextFocusDown="@id/recycler"
            android:nextFocusUp="@id/none"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:duplicateParentState="true"
                android:gravity="center"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="@string/source_sidebar_select_none"
                android:textColor="@color/selector_site_item_text"
                android:textSize="12sp" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/noneCheck"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/selector_check_circle"
                android:duplicateParentState="true" />
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/shape_line_tapered" />

    <com.fongmi.android.tv.ui.custom.CustomRecyclerView
        android:id="@+id/recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:overScrollMode="never" />

</androidx.appcompat.widget.LinearLayoutCompat>
