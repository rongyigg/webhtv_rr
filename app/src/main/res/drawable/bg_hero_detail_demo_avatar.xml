<?xml version="1.0" encoding="utf-8"?>
<!--
    静态骨架用头像占位：矩形渐变，由外层 60dp 圆形 outline 裁成圆形。
    故意保持矩形，用来验证 clipToOutline 的圆形裁剪是否生效。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <gradient
        android:angle="315"
        android:endColor="#FF1F1F1F"
        android:startColor="#FF5A5A5A"
        android:type="linear" />

</shape>
