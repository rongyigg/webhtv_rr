<?xml version="1.0" encoding="utf-8"?>
<!--
  首页 homeBtn 的状态背景，取自 ref_docs/activity_home_v2.xml：
      android:id="@+id/homeBtn"
      android:background="@drawable/selector_home_logo"

  两档：
    - focused  → shape_home_logo_focused：渐变红圆（home_tab_focus_start → home_tab_focus_end，与首页 Tab 同源）
    - 默认      → shape_home_logo_normal ：完全透明，无边框（未聚焦时小房子外面不许有红圈）

  与换源弹窗的 `selector_home_logo_source` 分开：那边底是浅灰面板，常态用 @color/white_10 圆；
  首页顶栏是纯黑底，按原版截图 ref_docs/home_ui.png 什么都不铺（实测 #020201 纯黑）。
  原版没有放大、没有白描边，这里也不加。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_focused="true"
        android:drawable="@drawable/shape_home_logo_focused" />
    <item android:drawable="@drawable/shape_home_logo_normal" />
</selector>
