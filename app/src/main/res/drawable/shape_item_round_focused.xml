<?xml version="1.0" encoding="utf-8"?>
<!--
  分类 Tab「聚焦」态：红色实心胶囊。
  几何照抄 ref_docs/shape_chip_round_normal.xml（radius 28dp + 左右 padding 6dp），
  填充照抄工程内同族 drawable shape_source_site_chip_focused.xml：
    #E50914(@color/red) → #F44336(@color/red_500) → #FF7A85，angle=0 = 从左到右，
    与 Compose 的 Brush.horizontalGradient（HeroFocusBrush）同一支渐变。
  与 ref_docs/tab_ui.png 的焦点胶囊实测一致（左 #E81822 → 右 #FC767D）。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="0"
        android:centerColor="@color/red_500"
        android:endColor="#FFFF7A85"
        android:startColor="@color/red"
        android:type="linear" />
    <corners android:radius="28dp" />
    <padding
        android:left="6dp"
        android:right="6dp" />
</shape>
