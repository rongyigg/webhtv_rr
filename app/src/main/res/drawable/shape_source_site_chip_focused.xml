<?xml version="1.0" encoding="utf-8"?>
<!--
  换源弹窗（ChangeSourceDialog）站点标签的焦点态：红渐变色块 + 白字。

  色标与 Compose 侧 HeroCommonUi.HeroFocusBrush、首页 Tab 栏焦点背景
  （HomeViewActivity.tabBackground）完全一致 —— 只有两段，不再插中间色：
    #E50914（@color/home_tab_focus_start = @color/red）→ #FF7A85（@color/home_tab_focus_end）
  angle=0 = 从左到右，对应 Compose 的 Brush.horizontalGradient。

  与常态 `shape_source_chip_round_normal` 保持同一套 padding（左右各 6dp）；
  不用渐变的固有尺寸撑高标签，所以上下各 inset 2dp，让渐变块落在 26dp 的标签高度内。
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetTop="2dp"
    android:insetBottom="2dp">
    <shape android:shape="rectangle">
        <gradient
            android:angle="0"
            android:endColor="@color/home_tab_focus_end"
            android:startColor="@color/home_tab_focus_start"
            android:type="linear" />
        <corners android:radius="28dp" />
        <padding
            android:left="6dp"
            android:right="6dp" />
    </shape>
</inset>
