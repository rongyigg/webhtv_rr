<?xml version="1.0" encoding="utf-8"?>
<!--
  源站切换（ChangeSourceDialog）站点标签焦点态：透明底 + 1.5dp 细线红框 @color/osd_red_end。
  与常态 `shape_source_chip_round_normal` 保持同一套 padding（左右各 6dp），
  inset 上下 2dp 让带描边的标签仍落在 26dp 行高内。
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetTop="2dp"
    android:insetBottom="2dp">
    <shape android:shape="rectangle">
        <solid android:color="@android:color/transparent" />
        <stroke
            android:width="1.5dp"
            android:color="@color/osd_red_end" />
        <corners android:radius="28dp" />
        <padding
            android:left="6dp"
            android:right="6dp" />
    </shape>
</inset>
