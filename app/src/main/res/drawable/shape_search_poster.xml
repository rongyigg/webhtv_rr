<?xml version="1.0" encoding="utf-8"?>
<!--
    搜索页结果卡底板：半透明黑（@color/black_20）+ 8dp 圆角。
    只铺在海报（120×180dp）这一层：ImageView 拿它当背景，靠 clipToOutline 把内容裁成同一轮廓。
    半径取 8dp 与 `@style/Vod.Grid.Large`（原版 rect 卡 shapeAppearanceOverlay）一致，
    也和全局焦点框 selector_vod / shape_vod_focused 的 8dp 完全重合 —— 红框才能严丝合缝贴住海报，
    不会出现「框比卡圆、卡角露在框外」的溢出感。剧名在圆角区域之外。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="@color/black_20" />

    <corners android:radius="8dp" />

</shape>
