<?xml version="1.0" encoding="utf-8"?>
<!--
    历史页「查看详情」按钮 · 常态。

    尺寸来源：ref_docs/fragment_history.xml L168-173 `btnResume` 高 32dp、文字 14sp、drawablePadding 4dp。
    圆角 16dp = 32dp 高的一半（胶囊），与首页分类 Tab「圆角 = 高度一半」同一条规则（13dp / 26dp）。
    填充色复用 @color/black_50，左右内边距 12dp 复用 HERO_TAB_H_PADDING 的 12dp。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <corners android:radius="16dp" />

    <solid android:color="@color/black_50" />

    <padding
        android:left="12dp"
        android:right="12dp" />
</shape>
