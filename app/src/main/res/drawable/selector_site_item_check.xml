<?xml version="1.0" encoding="utf-8"?>
<!--
  侧边栏迷你勾选圈（对应需求中的 selector_site_item_check）。

  MaterialCheckBox 的默认按钮是方框，这里用 android:button 换成逆向原版的圆形状态图：
  - 未勾选 → 24dp 空心圆（1.5dp 细环，环内透明）；
  - 已勾选 → 同一个空心圆 + 对勾（描边同色，不填满实心，和逆向截图一致）。

  颜色不写死在这里，统一交给 selector_site_item_check_tint：
  常态 #FFFFFF，行聚焦（白胶囊）#000000。
  下面四个 focused 变体是兜底：即使某些机型忽略了 buttonTint，焦点态仍是黑圈黑勾。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_focused="true"
        android:state_checked="true"
        android:drawable="@drawable/shape_site_item_check_on_focused" />
    <item
        android:state_focused="true"
        android:drawable="@drawable/shape_site_item_check_off_focused" />
    <item
        android:state_checked="true"
        android:drawable="@drawable/shape_site_item_check_on" />
    <item android:drawable="@drawable/shape_site_item_check_off" />
</selector>
