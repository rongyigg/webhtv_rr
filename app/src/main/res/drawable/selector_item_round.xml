<?xml version="1.0" encoding="utf-8"?>
<!--
  首页分类 Tab 胶囊三态，状态顺序与引用结构与 ref_docs/selector_item_round.xml 逐行一致：
    focused  → 红色实心（全站焦点块统一的 HeroFocusBrush 横向渐变）
    selected → 红色描边 + 深色半透明底（失焦但仍是当前分类）
    normal   → 深色半透明底

  ref_docs 只导出了 selector，三个 shape 的 solid / stroke 在反编译时被剥掉（同目录的
  shape_chip_round_normal / activated 只剩 corners + padding），所以这里按原文件结构补建：
    - 圆角 28dp、左右 padding 6dp：照抄 ref_docs/shape_chip_round_normal.xml / _activated.xml；
    - 红渐变（#E50914 → #F44336 → #FF7A85，angle=0）：照抄工程内同族 drawable
      shape_source_site_chip_focused.xml（全站实心焦点块统一这一支渐变）；
    - 红描边 2dp：#E50914，照抄 shape_source_site_chip_selected.xml；
    - 常态底色 #33000000（20% 黑）：ref_docs/tab_ui.png 未选胶囊实测约 15%~20% 黑，取整到 20%。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_focused="true"
        android:drawable="@drawable/shape_item_round_focused" />
    <item
        android:state_selected="true"
        android:drawable="@drawable/shape_item_round_activated" />
    <item android:drawable="@drawable/shape_item_round_normal" />
</selector>
