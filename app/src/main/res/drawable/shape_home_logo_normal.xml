<?xml version="1.0" encoding="utf-8"?>
<!--
  首页 homeBtn「未聚焦」底：细红边框 + 透明填充。

  为什么另建一个 shape 而不是复用 `shape_home_logo_normal_white`：
  后者是 `selector_home_logo_source`（换源弹窗 dialog_source.xml 里的小房子，底是浅灰面板）
  的常态态，填充 @color/white_10；首页顶栏是纯黑底，原版截图 ref_docs/home_ui.png 里
  小房子周围没有可见的圆底（x=52..100 / y=40..88 实测 #020201，不是 #1A1A1A），
  所以首页这一档按需求画细红边框、不铺填充。

  颜色只用真值：@color/red = #E50914，来源 ref_docs/shape_red_bar.xml 与
  ref_docs/shape_tmdb_badge.xml 的 `<solid android:color="#e50914"/>`，不写自编色值。
  1dp 描边即「细」；圆取 oval，与 ref_docs/shape_home_logo_normal_white.xml 同形。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@android:color/transparent" />
    <stroke
        android:width="1dp"
        android:color="@color/red" />
</shape>
