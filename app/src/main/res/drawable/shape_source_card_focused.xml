<?xml version="1.0" encoding="utf-8"?>
<!--
  换源结果卡的焦点描边，照搬 ref_docs/adapter_search.xml 根节点引用的 @drawable/selector_vod
  里用到的 shape_vod_focused：8dp 圆角 + 1.5dp 纯白描边、无填充。
  原版 selector_vod 在 leanback 源集，main 里按约定重建一份 source_ 前缀的等价资源。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <corners android:radius="8dp" />

    <stroke
        android:width="1.5dp"
        android:color="@color/white" />

</shape>
