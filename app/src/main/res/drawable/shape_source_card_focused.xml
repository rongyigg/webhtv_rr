<?xml version="1.0" encoding="utf-8"?>
<!--
  换源结果卡的焦点描边，照抄 ref_docs/adapter_search.xml 根节点引用的 @drawable/selector_vod
  里用到的 shape_vod_focused：8dp 圆角 + 1.5dp 描边、无填充。
  描边色跟随全局皮肤从纯白改为 @color/osd_focus，和首页 / 历史 / 收藏的海报焦点统一。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <corners android:radius="8dp" />

    <stroke
        android:width="1.5dp"
        android:color="@color/osd_focus" />

</shape>
