<?xml version="1.0" encoding="utf-8"?>
<!-- 侧边栏勾选圈（行聚焦）：未勾选 = 黑色空心圆，保证在白胶囊上可见。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@android:color/transparent" />
    <stroke
        android:width="1.5dp"
        android:color="@color/black" />
    <size
        android:width="20dp"
        android:height="20dp" />
</shape>
