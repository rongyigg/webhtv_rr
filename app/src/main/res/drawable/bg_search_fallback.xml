<?xml version="1.0" encoding="utf-8"?>
<!--
    搜索页兜底背景（没有首页大图时）：深蓝黑竖向渐变。
    0% #0B1119 → 55% #101823 → 100% 纯黑（与 Compose 版 FALLBACK_BACKGROUND 同色标）。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <gradient
        android:angle="270"
        android:centerColor="#FF101823"
        android:endColor="#FF000000"
        android:startColor="#FF0B1119" />

</shape>
