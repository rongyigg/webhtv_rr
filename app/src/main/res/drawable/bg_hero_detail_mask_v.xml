<?xml version="1.0" encoding="utf-8"?>
<!--
    纵向遮罩：0% 透明 → 55% 透明 → 100% 90% 黑。
    与 HeroDetailActivity.kt 的 HeroDetailMaskVertical 同色标。
    同样用 vector 保证 55% 这个色标不被 <shape> 强制挪到 50%。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="100dp"
    android:height="100dp"
    android:viewportWidth="100"
    android:viewportHeight="100">

    <path android:pathData="M0,0h100v100h-100z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="0"
                android:endY="100"
                android:startX="0"
                android:startY="0"
                android:type="linear">
                <item
                    android:color="#00000000"
                    android:offset="0" />
                <item
                    android:color="#00000000"
                    android:offset="0.55" />
                <item
                    android:color="#E6000000"
                    android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

</vector>
