<?xml version="1.0" encoding="utf-8"?>
<!--
    搜索页站点 Tab：焦点态。
    实心红渐变（与胶囊、键盘焦点键同一支色标）+ 13dp 圆角，无描边。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <gradient
        android:angle="0"
        android:endColor="@color/home_tab_focus_end"
        android:startColor="@color/home_tab_focus_start" />

    <corners android:radius="13dp" />

</shape>
