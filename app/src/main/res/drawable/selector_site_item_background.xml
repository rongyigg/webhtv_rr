<?xml version="1.0" encoding="utf-8"?>
<!--
  接口源侧边栏行背景（对应需求中的 selector_site_item_background）。

  只有两态：focused > normal。
  - focused  → 纯白胶囊（#FFFFFF + 20dp 圆角），文字由 selector_site_item_text 反转为黑色；
  - normal   → 全透明，行与深色面板融为一体。

  这里刻意没有 state_selected：点击行就是「切源并关窗」或「勾选」，
  选中态白框已彻底删除，只剩普通透明态和白色胶囊焦点态。

  焦点态用 inset 8dp/4dp 保留行距，白胶囊不会顶满 40dp 行高，
  行底 1dp 下划线因此落在胶囊之外，不会被白底吞掉。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_focused="true"
        android:drawable="@drawable/shape_site_item_focused_white" />
    <item android:drawable="@android:color/transparent" />
</selector>
