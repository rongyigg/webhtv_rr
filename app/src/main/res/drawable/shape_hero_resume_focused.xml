<?xml version="1.0" encoding="utf-8"?>
<!--
    历史页「查看详情」按钮 · 焦点态（activity_history_view.xml 引用）。

    焦点底色与首页 HeroFocusBrush 保持一致：
    首页 Tab 栏同源两段渐变 home_tab_focus_start → home_tab_focus_end，不再使用实心纯红。
    圆角 / 内边距与常态完全一致，避免焦点切换时按钮尺寸跳动。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <corners android:radius="16dp" />

    <gradient
        android:angle="0"
        android:endColor="@color/home_tab_focus_end"
        android:startColor="@color/home_tab_focus_start"
        android:type="linear" />

    <padding
        android:left="12dp"
        android:right="12dp" />
</shape>
