<resources>

    <style name="Theme.Base" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/white</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.WebHTV.LightDialog</item>
        <item name="android:windowBackground">?attr/colorSurface</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:windowAnimationStyle">@style/NoAnim</item>
    </style>

    <style name="Theme.Splash" parent="Theme.Base">
        <item name="android:windowBackground">@drawable/startup_window_background</item>
    </style>

    <style name="Theme.App" parent="Theme.Base" />

    <!--
        播放页专用主题：窗口底色固定纯黑。
        起播瞬间（Activity 正在创建、内容还没画出来，或播放器还没吐第一帧）只会露黑底，
        不会再闪一下应用主题色 / 首页壁纸。
    -->
    <style name="Theme.Video" parent="Theme.App">
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <style name="Theme.Crash" parent="Theme.Base">
        <item name="android:windowBackground">@color/grey_800</item>
        <item name="android:windowDisablePreview">true</item>
    </style>

    <style name="NoAnim">
        <item name="android:activityOpenEnterAnimation">@null</item>
        <item name="android:activityOpenExitAnimation">@null</item>
        <item name="android:activityCloseEnterAnimation">@null</item>
        <item name="android:activityCloseExitAnimation">@null</item>
    </style>

    <style name="Shadow">
        <item name="android:shadowColor">#B0000000</item>
        <item name="android:shadowDx">1.5</item>
        <item name="android:shadowDy">1.5</item>
        <item name="android:shadowRadius">2</item>
    </style>

    <style name="Control">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/selector_chip</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:nextFocusDown">@id/timeBar</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="ControlSheetTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">13dp</item>
        <item name="android:layout_marginBottom">7dp</item>
        <item name="android:textColor">@color/white_70</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ControlSheetButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginEnd">7dp</item>
        <item name="android:background">@drawable/selector_control_sheet_button</item>
        <item name="android:gravity">center</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">@color/selector_control_sheet_text</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="VideoActionButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">12sp</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="AudioActionIconButton">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/selector_audio_action_icon</item>
        <item name="android:focusable">true</item>
        <item name="android:padding">8dp</item>
        <item name="android:scaleType">center</item>
        <item name="android:tint">@color/white</item>
    </style>

    <style name="ShapeAppearance.WebHTV.AudioCover" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Keep TV dialogs aligned with the active app theme instead of pinning a fixed palette. -->
    <style name="ThemeOverlay.WebHTV.LightDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="alertDialogStyle">@style/MaterialAlertDialog.WebHTV.Rounded</item>
    </style>

    <!--
        播放页 OSD 底部文字按钮：默认透明，焦点态是 #E50914 → #FD7D83 的水平红渐变胶囊。
        尺寸照抄原逆向 App 截图：高 30dp、左右内边距 12dp（两字按钮约 52dp 宽），
        圆角 15dp 即高度的一半；字号 14sp，整行贴左排布（禁止居中）。
        间距 8dp：逆向截图量得相邻按钮文字墨迹间隙 67px ≈ 33.5dp，
        正好等于 paddingEnd 12dp + 间距 8dp + paddingStart 12dp；16dp 时间隙达 84px 且整行溢出。
    -->
    <style name="OsdAction">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/selector_osd_action</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- 播放页 OSD 图标按钮（上一集 / 下一集）：按钮 48dp，焦点 oval 正圆，与文字按钮共用 8dp 间距。 -->
    <style name="OsdIcon">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/selector_osd_icon</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">@color/white</item>
    </style>

    <!--
        选集面板线路按钮：逆向截图取样 88x56px = 44x28dp、1dp 描边、约 4dp 小圆角，
        文字 14sp，左右内边距 8dp（两字线路名宽度 27.5dp + 16dp ≈ 44dp，与逆向一致）。
    -->
    <style name="OsdChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/selector_osd_chip</item>
        <item name="android:ellipsize">end</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:gravity">center</item>
        <item name="android:maxWidth">280dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!--
        选集面板分页按钮：逆向截图取样 77x44px = 38.5x22dp、1dp 描边、全圆角（高度的一半 11dp），
        文字 14sp —— 与下方集数网格（OsdEpisodeAdapter 固定 14sp）完全一致，
        并且小于左侧「选集」标题的 15sp，保证标题仍是这块最高层级的文字。
        最小宽 38dp（单页「1-6」宽度与逆向一致）。
    -->
    <style name="OsdPage">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">22dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/selector_osd_page</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">38dp</item>
        <item name="android:paddingStart">9dp</item>
        <item name="android:paddingEnd">9dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!--
        选集面板顶部操作标签（少列 / 多列、正序 / 倒序）。
        字号 14sp，与下方集数网格和分页标签同一档，且小于「播放线路 / 选集」标题的 15sp；保留加粗。
        高度压到 26dp（原 34dp）：焦点实心红胶囊 / 选中红框都被钳制成 13dp 圆角的扁平长条，
        不再圆滚滚；上下不留 padding，文字靠 gravity=center 居中。
    -->
    <style name="OsdTab">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">26dp</item>
        <item name="android:layout_marginStart">14dp</item>
        <item name="android:background">@drawable/selector_osd_action</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>
