<?xml version="1.0" encoding="utf-8"?>
<!-- 全局焦点皮肤（圆胶囊）：红渐变填充，去掉原来的 1.5dp 白描边。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <gradient
        android:angle="0"
        android:endColor="@color/osd_accent_light"
        android:startColor="@color/osd_accent" />

    <corners android:radius="28dp" />

    <padding
        android:bottom="8dp"
        android:left="14dp"
        android:right="14dp"
        android:top="8dp" />

</shape>
