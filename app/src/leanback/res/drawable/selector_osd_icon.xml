<?xml version="1.0" encoding="utf-8"?>
<!--
    播放页 OSD 上一集 / 下一集图标按钮：焦点态用椭圆红渐变，其余全透明。
    颜色引用全局资源（@color/osd_accent_light → @color/osd_red_end），不写十六进制字面量。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <gradient
                android:angle="0"
                android:endColor="@color/osd_red_end"
                android:startColor="@color/osd_accent_light" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
