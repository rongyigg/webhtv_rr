<?xml version="1.0" encoding="utf-8"?>
<!-- 全局「当前项」皮肤（小胶囊）：透明底 + 1dp 细红框，和焦点红渐变区分开。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <corners android:radius="4dp" />

    <padding
        android:bottom="8dp"
        android:left="12dp"
        android:right="12dp"
        android:top="8dp" />

    <stroke
        android:width="1dp"
        android:color="@color/osd_focus" />

</shape>
