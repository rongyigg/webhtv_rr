<?xml version="1.0" encoding="utf-8"?>
<!--
    全局「选中胶囊」：与 @drawable/bg_global_focus_capsule 完全同一形状（28dp 全圆角），
    只是把实心渐变换成透明底 + 1.5dp 细线红框 @color/osd_red_end。
    用于「已选中但焦点不在它身上」的首页分类 Tab 与选集分页标签当前页。

    圆角与焦点态逐字一致（28dp），两态切换时标签外形不会跳动；
    同样不带 <padding>，尺寸完全由调用方的布局决定。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="@android:color/transparent" />

    <stroke
        android:width="1.5dp"
        android:color="@color/osd_red_end" />

    <corners android:radius="28dp" />

</shape>
