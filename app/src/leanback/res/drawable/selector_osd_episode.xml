<?xml version="1.0" encoding="utf-8"?>
<!--
    播放页选集卡片背景（状态矩阵严格区分焦点 / 选中）：
      - 焦点：全局实心焦点样式 @drawable/bg_global_focus_solid_red（实心红，不能是框）。
      - 选中（正在播放但无焦点）：全局选中样式 @drawable/bg_global_selected_red_border
        （透明底 + 1.5dp 细线红框 + 4dp 圆角）。
      - 普通：透明底，无描边（面板本身是半透明遮罩，卡片不带底色）。
    内边距由 OsdEpisodeAdapter.applyDensity 每次绑定统一设置（14sp / 上下 6dp / 左右 12dp），
    所以这里刻意不再带 padding，避免焦点态与普通态高度不一致。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:drawable="@drawable/bg_global_focus_solid_red"
        android:state_focused="true" />
    <item
        android:drawable="@drawable/bg_global_selected_red_border"
        android:state_activated="true" />
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</selector>
