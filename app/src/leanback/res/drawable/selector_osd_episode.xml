<?xml version="1.0" encoding="utf-8"?>
<!--
    播放页选集卡片背景（状态矩阵严格区分焦点 / 选中 / 普通）：
      - 焦点：全局实心焦点样式 @drawable/bg_global_focus_solid_red（实心红，不能是框）。
      - 选中（正在播放但无焦点）：全局选中样式 @drawable/bg_global_selected_red_border
        （透明底 + 1.5dp 细线红框 + 4dp 圆角）。
      - 普通（未选中且无焦点）：独立的半透明长条 @color/white_20 + 4dp 圆角。
        这是面板渐变遮罩之上的第 2 层背景，纯黑视频上也能看清卡片轮廓；
        长条形，绝不用正圆 / 胶囊圆角。
    卡片高度固定 38dp（adapter_osd_episode.xml），三种状态共用同一外形，
    所以这里刻意不带 padding，内边距由 OsdEpisodeAdapter.applyDensity 统一设置。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:drawable="@drawable/bg_global_focus_solid_red"
        android:state_focused="true" />
    <item
        android:drawable="@drawable/bg_global_selected_red_border"
        android:state_activated="true" />
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/white_20" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</selector>
