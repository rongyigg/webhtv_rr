<?xml version="1.0" encoding="utf-8"?>
<!--
    播放页 OSD 底部动作按钮（含选集面板的「少列/多列」「正序/倒序」标签）：
    - 焦点：统一引用全局实心焦点样式 @drawable/bg_global_focus_solid_red
      （播放选集面板同款横向红渐变，不再在这里各写一份渐变色）
    - 按下：半透明浅底
    - 默认 / 其余：全透明，压在画面上
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:drawable="@drawable/bg_global_focus_solid_red"
        android:state_focused="true" />
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/osd_surface" />
            <corners android:radius="15dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="15dp" />
        </shape>
    </item>
</selector>
