<?xml version="1.0" encoding="utf-8"?>
<!--
    播放页 OSD 底部动作按钮（含选集面板的「少列/多列」「正序/倒序」标签）：
    - 焦点：全局实心焦点胶囊 @drawable/bg_global_focus_capsule
      （换源弹窗同款红渐变 + 28dp 全圆角；30dp / 34dp 高的按钮被钳制成满高胶囊，禁止改成方形）
    - 按下：半透明浅底
    - 默认 / 其余：全透明，压在画面上
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:drawable="@drawable/bg_global_focus_capsule"
        android:state_focused="true" />
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/osd_surface" />
            <corners android:radius="15dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="15dp" />
        </shape>
    </item>
</selector>
