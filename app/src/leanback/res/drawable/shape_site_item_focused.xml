<?xml version="1.0" encoding="utf-8"?>
<!-- 站点/分类标签焦点：原先是 #2F6FED 蓝底 + 2dp 白描边，改成红渐变填充。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
