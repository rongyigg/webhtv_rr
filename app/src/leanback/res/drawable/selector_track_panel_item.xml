<?xml version="1.0" encoding="utf-8"?>
<!--
    轨道面板列表项背景：
    - 焦点：@color/osd_focus → @color/osd_focus_dark 的 20dp 胶囊红渐变（40dp 行高的一半）；
    - 已选中：半透明深色底 + @color/osd_focus 描边胶囊，配合红色文字；
    - 普通：透明。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@color/osd_focus_dark"
                android:startColor="@color/osd_focus" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/osd_surface" />
            <stroke
                android:width="1dp"
                android:color="@color/osd_focus" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</selector>
