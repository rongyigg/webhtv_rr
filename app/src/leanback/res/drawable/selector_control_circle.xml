<?xml version="1.0" encoding="utf-8"?>
<!--
    播放页弹窗右上/头部那排圆形图标按钮的皮肤
    （dialog_track 头部的 choose / search / ai / subtitle / offset 等，
      以及 dialog_subtitle 的 large / small / up / down / reset 共用这一个皮肤）。

    10.26 按用户实测修正：原版聚焦时是**透明**的 —— 不画实心圆，焦点只体现为「没有背景」。
    所以这里不再有 focused 档，聚焦直接落到下面两档：

    - 选中：@drawable/shape_chip_activated（细线红框）；
    - 常态 / 聚焦：@drawable/shape_chip_normal（透明 + 8dp/12dp 内边距）。

    注意：常态/选中档会带 8dp/12dp 内边距，按钮自身再叠 8dp padding，
    这是原版尺寸（图标四周留白），不要为了「看起来更紧凑」把它改小。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_selected="true"
        android:drawable="@drawable/shape_chip_activated" />
    <item android:drawable="@drawable/shape_chip_normal" />
</selector>
