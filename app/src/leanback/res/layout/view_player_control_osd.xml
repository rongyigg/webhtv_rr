<?xml version="1.0" encoding="utf-8"?>
<!--
    播放页 OSD 控制层（纯 View 实现，不使用 Compose）。
    - 左上：分辨率；右上：实时网速
    - 左下：剧集 Logo（无图时隐藏）
    - 底部：进度条 + 上一集 / 播放 / 下一集 / 选集 / EXO / 硬解 / 刷新 / 重播 /
            循环 / 倍速 / 原始 / 字幕 / 轨道 / 片头 / 片尾
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_player_osd_scrim"
    android:clickable="false"
    android:focusable="false"
    android:visibility="gone"
    tools:visibility="visible">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/resolution"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="24dp"
        android:layout_marginTop="20dp"
        android:fontFeatureSettings="tnum"
        android:shadowColor="#99000000"
        android:shadowDx="1"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:textColor="@color/white"
        android:textSize="20sp"
        tools:text="3840 x 2160" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/netSpeed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="24dp"
        android:fontFeatureSettings="tnum"
        android:shadowColor="#99000000"
        android:shadowDx="1"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:textColor="@color/white"
        android:textSize="20sp"
        tools:text="2.2 MB/s" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/osdBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="14dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/vodLogo"
            android:layout_width="wrap_content"
            android:layout_height="90dp"
            android:layout_marginBottom="4dp"
            android:adjustViewBounds="true"
            android:scaleType="fitStart"
            android:visibility="gone"
            tools:src="@drawable/artwork"
            tools:visibility="visible" />

        <com.fongmi.android.tv.ui.custom.CustomSeekView
            android:id="@+id/osdSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nextFocusDown="@id/osdPrev" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="false"
            android:overScrollMode="never"
            android:scrollbars="none">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/osdActions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/osdPrev"
                    style="@style/OsdIcon"
                    android:contentDescription="@string/play_prev"
                    android:nextFocusUp="@id/osdSeek"
                    android:src="@drawable/exo_icon_previous" />

                <FrameLayout
                    android:id="@+id/osdPlay"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/selector_osd_play_button"
                    android:clickable="true"
                    android:contentDescription="@string/play"
                    android:focusable="true"
                    android:focusableInTouchMode="true">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/osdPlayIcon"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clickable="false"
                        android:focusable="false"
                        android:padding="13dp"
                        android:src="@drawable/exo_icon_play"
                        android:tint="@color/white" />

                </FrameLayout>

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/osdNext"
                    style="@style/OsdIcon"
                    android:layout_marginEnd="14dp"
                    android:contentDescription="@string/play_next"
                    android:src="@drawable/exo_icon_next" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/osdEpisodes"
                    style="@style/OsdAction"
                    android:text="@string/play_episodes" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/osdKernel"
                    style="@style/OsdAction"
                    android:text="@string/play_exo" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/osdDecode"
                    style="@style/OsdAction"
                    android:text="@string/play_decode" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/osdRefresh"
                    style="@style/OsdAction"
                    android:text="@string/play_reset" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/osdReplay"
                    style="@style/OsdAction"
                    android:text="@string/play_replay" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/osdRepeat"
                    style="@style/OsdAction"
                    android:text="@string/play_repeat" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/osdSpeed"
                    style="@style/OsdAction"
                    android:fontFeatureSettings="tnum"
                    android:text="@string/play_speed" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/osdScale"
                    style="@style/OsdAction"
                    android:text="@string/play_scale" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/osdText"
                    style="@style/OsdAction"
                    android:text="@string/play_track_text" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/osdTrack"
                    style="@style/OsdAction"
                    android:text="@string/play_track" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/osdOpening"
                    style="@style/OsdAction"
                    android:text="@string/play_op" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/osdEnding"
                    style="@style/OsdAction"
                    android:text="@string/play_ed" />

            </androidx.appcompat.widget.LinearLayoutCompat>

        </HorizontalScrollView>

    </androidx.appcompat.widget.LinearLayoutCompat>

</FrameLayout>
