<?xml version="1.0" encoding="utf-8"?>
<!--
    播放页 OSD 控制层（纯 View 实现，不使用 Compose）。
    - 左上：分辨率；右上：实时网速
    - 左下：剧集艺术字 vodLogo（HeroLogoCache / TmdbMatchCache 命中则加载艺术字并隐藏文字标题，
            未命中回退文字标题；为空则整块隐藏）
    - 底部：进度条 + 严格顺序的按钮行（整行靠左 start，禁止居中）：
            上一集 → 下一集 → 选集 → EXO → 硬解 → 刷新 → 重播 →
            倍速 → 画面比例 → 字幕 → 轨道 → 播放参数 → 片头 → 片尾
    说明：中间的播放/暂停大圆键已删除，确认键（DPAD_CENTER）直接接管播放/暂停。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clickable="false"
    android:focusable="false"
    android:visibility="gone"
    tools:visibility="visible">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/resolution"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="24dp"
        android:layout_marginTop="20dp"
        android:fontFeatureSettings="tnum"
        android:shadowColor="#99000000"
        android:shadowDx="1"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:textColor="@color/white"
        android:textSize="16sp"
        tools:text="3840 x 2160" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/netSpeed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="24dp"
        android:fontFeatureSettings="tnum"
        android:shadowColor="#99000000"
        android:shadowDx="1"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:textColor="@color/white"
        android:textSize="16sp"
        tools:text="2.2 MB/s" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/osdBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_osd_scrim_gradient"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="14dp">

        <!--
            左下角艺术字：严格照抄逆向 VideoActivity.V2() 的取图顺序。
            vodLogo 只放 HeroLogoCache 命中的透明艺术字（逆向 B2() 的 210x84dp 约束），
            vodTitle 是同一位置的文字回退，二者互斥显示，绝不与选集面板重叠。
        -->
        <FrameLayout
            android:id="@+id/vodLogoBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:clipChildren="true"
            android:visibility="gone"
            tools:visibility="visible">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/vodLogo"
                android:layout_width="210dp"
                android:layout_height="84dp"
                android:layout_gravity="start|bottom"
                android:scaleType="fitCenter"
                android:visibility="gone"
                tools:visibility="visible" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/vodTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|bottom"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:letterSpacing="0.04"
                android:maxWidth="320dp"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="6"
                android:singleLine="true"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="The Last of Us"
                tools:visibility="visible" />

        </FrameLayout>

        <com.fongmi.android.tv.ui.custom.CustomSeekView
            android:id="@+id/osdSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nextFocusDown="@id/osdPrev" />

        <!--
            靠左：fillViewport 让按钮行在内容不足一屏时撑满可视宽度，
            layout_gravity=start + gravity=start 把整行按钮贴左排布，禁止居中。
            内容超过一屏时退化为可横向滚动，不裁切任何按钮。
        -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/osdActions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:gravity="start|center_vertical"
                android:orientation="horizontal">

                <!-- 1. 上一集 -->
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/osdPrev"
                    style="@style/OsdIcon"
                    android:contentDescription="@string/play_prev"
                    android:nextFocusUp="@id/osdSeek"
                    android:src="@drawable/exo_icon_previous" />

                <!-- 2. 下一集 -->
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/osdNext"
                    style="@style/OsdIcon"
                    android:contentDescription="@string/play_next"
                    android:src="@drawable/exo_icon_next" />

                <!-- 3. 选集 -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/osdEpisodes"
                    style="@style/OsdAction"
                    android:text="@string/play_episodes" />

                <!-- 4. EXO / 播放内核 -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/osdKernel"
                    style="@style/OsdAction"
                    android:text="@string/play_exo" />

                <!-- 5. 硬解 -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/osdDecode"
                    style="@style/OsdAction"
                    android:text="@string/play_decode" />

                <!-- 6. 刷新 -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/osdRefresh"
                    style="@style/OsdAction"
                    android:text="@string/play_reset" />

                <!-- 7. 重播 -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/osdReplay"
                    style="@style/OsdAction"
                    android:text="@string/play_replay" />

                <!-- 8. 倍速 -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/osdSpeed"
                    style="@style/OsdAction"
                    android:fontFeatureSettings="tnum"
                    android:text="@string/play_speed" />

                <!-- 9. 画面比例 -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/osdScale"
                    style="@style/OsdAction"
                    android:text="@string/play_scale" />

                <!-- 10. 字幕 -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/osdText"
                    style="@style/OsdAction"
                    android:text="@string/play_track_text" />

                <!-- 11. 轨道：逆向 dialog_track.xml 的「视频轨道 / 音频轨道」双列面板 -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/osdTrack"
                    style="@style/OsdAction"
                    android:text="@string/play_track" />

                <!-- 12. 播放参数 -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/osdPlayParams"
                    style="@style/OsdAction"
                    android:text="@string/play_params" />

                <!-- 13. 片头 -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/osdOpening"
                    style="@style/OsdAction"
                    android:text="@string/play_op" />

                <!-- 14. 片尾 -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/osdEnding"
                    style="@style/OsdAction"
                    android:text="@string/play_ed" />

            </androidx.appcompat.widget.LinearLayoutCompat>

        </HorizontalScrollView>

    </androidx.appcompat.widget.LinearLayoutCompat>

</FrameLayout>
