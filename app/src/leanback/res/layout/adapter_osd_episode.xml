<?xml version="1.0" encoding="utf-8"?>
<!--
    播放页底部选集卡片：沿用逆向 ref_docs/adapter_episode.xml 的结构。
    - 卡片：focusable 的 FrameLayout + @drawable/selector_osd_episode（黑底/红渐变，5dp 圆角）
    - 文字：14sp 单行居中的 MaterialTextView，颜色走 selector_osd_episode_text
      （焦点白字 / 正在播放但失焦红字 / 普通白字）
    - Lottie：20x25dp，约束在卡片内部右侧垂直居中（clipChildren=true，负边距已删除，
      不再掉出卡片）；保留 @raw/equalizer 自带颜色，不加白色滤镜；
      只有 isSelected 的集数 VISIBLE，其余 GONE。
    - 纵向焦点由 VideoActivity.dispatchEpisodePanelVerticalKey 显式闭环，这里不再写
      nextFocusUp/Down：逆向布局里的 @id/flag、@id/array 在本工程指向的是嵌入页
      （非全屏）的同名控件，全屏面板里取不到，会让网格首行按「上」直接被吞掉。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginEnd="8dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/selector_osd_episode"
    android:clipChildren="true"
    android:clipToPadding="true"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="marquee"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:gravity="center"
        android:marqueeRepeatLimit="marquee_forever"
        android:scrollHorizontally="true"
        android:singleLine="true"
        android:textColor="@color/selector_osd_episode_text"
        android:textSize="14sp"
        tools:text="第20集" />

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottie"
        android:layout_width="20dp"
        android:layout_height="25dp"
        android:layout_gravity="end|center_vertical"
        android:visibility="gone"
        app:lottie_autoPlay="false"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/equalizer"
        tools:visibility="visible" />

</FrameLayout>
