<?xml version="1.0" encoding="utf-8"?>
<!--
    播放页「字幕 / 音轨 / 视轨」轨道列表弹窗（逆向 ref_docs/dialog_track.xml 的单列形态）。
    - 外壳与轨道面板同源：根节点 @drawable/shape_controller（很透明的渐变黑
      black_20 → black_50 + 8dp 顶部圆角），全宽贴底；
    - 头部 24dp / 24dp / 24dp / 8dp，标题 16sp 白字；
    - 头部图标按钮统一 @drawable/selector_control_circle（焦点 30dp 红渐变实心圆、
      未聚焦透明）+ 8dp padding + 纯白 tint，与原版 dialog_track 的 choose / subtitle / offset 一致；
    - 列表行见 adapter_track.xml：16sp、紧凑行高、焦点渐变红长条、选中红字。
-->
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/shape_controller"
    android:orientation="vertical"
    android:paddingBottom="0dp">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="8dp">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/white"
            android:textSize="16sp"
            tools:text="選擇字幕" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/secondary"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="@string/play_track_secondary_subtitle"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/choose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:background="@drawable/selector_control_circle"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_action_choose"
            android:visibility="gone"
            app:tint="@color/white"
            tools:visibility="visible" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/search"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:background="@drawable/selector_control_circle"
            android:contentDescription="@string/subtitle_manual_search"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_action_search"
            android:visibility="gone"
            app:tint="@color/white"
            tools:visibility="visible" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:background="@drawable/selector_control_circle"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_action_subtitle"
            android:visibility="gone"
            app:tint="@color/white"
            tools:visibility="visible" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/offset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:background="@drawable/selector_control_circle"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_action_offset"
            android:visibility="gone"
            app:tint="@color/white"
            tools:visibility="visible" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/aiStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp"
        android:textColor="@color/white_70"
        android:textSize="13sp"
        android:visibility="gone"
        tools:text="AI 正在翻譯：1/3 分塊，約剩 20s"
        tools:visibility="visible" />

    <com.fongmi.android.tv.ui.custom.CustomRecyclerView
        android:id="@+id/recycler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:maxHeight="160dp"
        tools:listitem="@layout/adapter_track" />

</androidx.appcompat.widget.LinearLayoutCompat>
