<?xml version="1.0" encoding="utf-8"?>
<!--
    轨道面板列表项：
    - 普通 / 未选中：全透明背景、白字
    - 有焦点（遥控器选中）：加深长条 @color/white_30、纯白字
    - 已选中（当前生效的轨道）：长条 @color/white_20、文字用 Paint LinearGradient 红渐变
    - 绝对直角（selector_track_panel_item 圆角固定 0dp）、字号 14sp、行高 40dp
-->
<com.google.android.material.textview.MaterialTextView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/text"
    android:layout_width="match_parent"
    android:layout_height="40dp"
    android:background="@drawable/selector_track_panel_item"
    android:ellipsize="end"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:singleLine="true"
    android:textColor="@color/selector_track_panel_text"
    android:textSize="14sp"
    tools:text="Japanese 5.1" />
